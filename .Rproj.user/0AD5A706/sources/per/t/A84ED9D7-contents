head(osb)
osb_geocoded <- osb %>%
  mutate(query = paste(zone_name, "Organize Sanayi Bolgesi", province, "Turkey")) %>%
  geocode(query, method = "osm", lat = lat, lon = lon)


sum(!is.na(osb_geocoded$lat))

#only taking those that were matched by their zone names for time constraint for this project.
osb_geocoded <- osb_geocoded %>% filter(!is.na(lat))

#checking to see if those that matched have decent geographic coverage
osb_geocoded %>% 
  count(province) %>% 
  arrange(desc(n))
#54/81 provinces. moving on

#turning it into sf
osb_sf <- osb_geocoded %>%
  st_as_sf(coords = c("lon", "lat"), crs = 4326)

# download turkey boundary with level 2 = district.
turkey_district <- gadm(country = "TUR", level = 2, path = tempdir()) %>% 
  st_as_sf()

# map the industrial zones
ggplot() +
  geom_sf(data = turkey_district, fill = "grey95", color = "grey70", linewidth = 0.3) +
  geom_sf(data = osb_sf, color = "red", size = 1.5, alpha = 0.7) +
  theme_minimal() +
  labs(title = "Organized Industrial Zones in Turkey - District Level",
       subtitle = "114 zones geocoded via OSM",
       caption = "Source: OSBÜK, OpenStreetMap")

# spatial join zones to districts
osb_sf <- osb_sf %>%
  st_join(turkey_district %>% select(NAME_1, NAME_2))

district_with_zones <- turkey_district %>%
  st_join(osb_sf %>% select(zone_name)) %>%
  st_drop_geometry() %>%
  filter(!is.na(zone_name)) %>%
  distinct(GID_2) %>%
  pull(GID_2)

zone_district <- turkey_district %>%
  filter(GID_2 %in% district_with_zones)

non_zone_district <- turkey_district %>%
  filter(NAME_1 %in% zone_district$NAME_1,
         !GID_2 %in% district_with_zones)





 