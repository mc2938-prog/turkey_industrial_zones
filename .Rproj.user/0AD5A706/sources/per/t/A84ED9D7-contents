#2. Cleaning the data
#OSB - INDUSTRIAL ZONE FILE
#Clean the special characters in turkish language 
fix_turkish <- function(x) {
  x <- gsub("ş", "s", x)
  x <- gsub("Ş", "S", x)
  x <- gsub("ı", "i", x)
  x <- gsub("İ", "I", x)
  x <- gsub("ğ", "g", x)
  x <- gsub("Ğ", "G", x)
  x <- gsub("ü", "u", x)
  x <- gsub("Ü", "U", x)
  x <- gsub("ö", "o", x)
  x <- gsub("Ö", "O", x)
  x <- gsub("ç", "c", x)
  x <- gsub("Ç", "C", x)
  x
}

# Apply to column names
osb <- osb %>%
  rename_with(~ fix_turkish(.) %>% tolower() %>% gsub(" ", "_", .))

# Rename the column names for ease and for understanding the english equivalent
colnames(osb)
